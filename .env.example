# --- DevOps Nexus Core Platform Configs ---
PORT=8000
LOG_LEVEL=info

# --- Observability Stack Integration ---
PROMETHEUS_URL=http://prometheus-service.devops-nexus.svc.cluster.local:9090
LOKI_URL=http://loki-service.devops-nexus.svc.cluster.local:3100

# --- Continuous Delivery ---
ARGOCD_SERVER=argocd-server.argocd.svc.cluster.local
ARGOCD_TOKEN=my-argocd-token-placeholder

# --- AI Diagnostics Service ---
# Configurable providers: "ollama", "openai", "groq", "lmstudio", "bedrock"
# groq -> OpenAI-compatible Groq API; set GROQ_API_KEY and LLM_MODEL (e.g. llama-3.3-70b-versatile)
AI_PROVIDER=bedrock
GROQ_API_KEY=your-groq-api-key-here
LLM_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=your-openai-api-key-here
OLLAMA_HOST=http://localhost:11434
LMSTUDIO_HOST=http://localhost:1234/v1

# --- AWS Bedrock AI (used when AI_PROVIDER=bedrock) ---
# Region and model MUST match the account/cluster region (ap-south-1 / Mumbai).
# BEDROCK_MODEL_ID uses the APAC inference profile (Amazon Nova Pro).
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=apac.amazon.nova-pro-v1:0

# --- Cache Database ---
REDIS_URL=redis://localhost:6379/0

# --- Persistent AWS / Amazon EKS Integration ---
# AWS_REGION is the default region for AWS SDK clients (and the Bedrock region fallback).
AWS_REGION=ap-south-1
DEFAULT_AWS_ACCOUNT_ID=605294565283
DEFAULT_AWS_ROLE_ARN=arn:aws:iam::605294565283:role/DevOpsNexusAccessRole
DEFAULT_AWS_REGION=ap-south-1
